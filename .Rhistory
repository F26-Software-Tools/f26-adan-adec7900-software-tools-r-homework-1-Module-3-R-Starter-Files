# Clear the workspace
rm(list = ls()) # Clear environment
gc()            # Clear memory
cat("\f")       # Clear console
# Define your fizz(n) function below:
fizz <- function(n) {
if (n %% 3 == 0) return("Fizz")       # making an if statement that returns "Fizz" if there is no remainder when we divide "n" by 3
else                                  # if there is one, then the function will return ""
return("")
}
# Use commands below to test your function:
fizz(5L)  # integer input
fizz(6L)  # integer input
fizz(5)   # non-integer input
fizz(6.3) # non-integer input
# Define your buzz(n) function below:
buzz <- function(n) {
if (n %% 5 == 0) return("Buzz")       # making an if statement that returns "Buzz" if there is no remainder when we divide "n" by 5
else                                  # if there is one, then the function will return ""
return("")
}
# Use commands below to test your function:
buzz(5L)  # integer input
buzz(6L)  # integer input
buzz(5)   # non-integer input
buzz(6.3) # non-integer input
# Define your fizzbuzz(n) function below:
fizzbuzz <- function(n) {
return(paste(fizz(n),buzz(n)))      # using the paste() function which combines both the fizz and buzz functions into a new one
}
paste("a", "b")
paste("a", "")
# Use commands below to test your function:
fizzbuzz(4L)  # integer input
fizzbuzz(6L)  # integer input
fizzbuzz(15L) # integer input
fizzbuzz(4)   # non-integer input
fizzbuzz(6.3) # non-integer input
# Define your fizzbuzz(n) function below:
fizzbuzz <- function(n) {
return(paste(fizz(n),buzz(n), sep =""))      # using the paste() function which combines both the fizz and buzz functions into a new one
}
# Use commands below to test your function:
fizzbuzz(4L)  # integer input
fizzbuzz(6L)  # integer input
fizzbuzz(15L) # integer input
fizzbuzz(4)   # non-integer input
fizzbuzz(6.3) # non-integer input
fizzbuzz(15)  # non-integer input
