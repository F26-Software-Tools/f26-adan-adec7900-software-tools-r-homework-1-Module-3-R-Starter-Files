# Define your fbr(n,m) function below: This code was provided by the Professor when I asked for help,
fbr <- function(n,m) {
x <- seq(from = n, to = m, by = 1) # same as n:m
y <- rep(NA, length(x))
for (i in 1:length(x)) {
if (!fizzbuzz(x[i]) == "") { #begin if
y[i] <- fizzbuzz(x[i])
} else {
y[i] <- x[i]
} #end if
}
return(y)
}
