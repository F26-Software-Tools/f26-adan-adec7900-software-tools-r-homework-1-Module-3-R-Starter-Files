#---------------------------------------------------
# The simplest version is
fizz <- function(n) {
if (n %% 3 == 0) "Fizz" else ""
}
fizz(5)
fizz(5L)
fizz(6)
fizz(6L)
# Note that the following version works on its own,
# but fails as part of fizzbuzz()
fizz.print <- function(n) {
if (n %% 3 == 0) {
print("Fizz")
} else {
print("")
}
}
fizz.print(5)
fizz.print(6)
# Optional version with error message for non-integer argument
fizz.err <- function(n) {
if (is.integer(n)) {
if (n %% 3 == 0) "Fizz" else ""
} else stop("Supplied argument is not an integer")
}
fizz.err(5)
fizz.err(5L)
fizz.err(6)
fizz.err(6L)
# Optional vectorized version
fizz.vec <- function(n) {
ifelse(n %% 3 == 0, "Fizz", "")
}
