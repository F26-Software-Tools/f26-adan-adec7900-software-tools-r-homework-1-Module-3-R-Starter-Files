# Simplest version
fbr <- function(n,m) {
x <- seq(from = n, to = m, by = 1) # same as n:m
y <- rep(NA, length(x))
for (i in 1:length(x)) {
if (!fizzbuzz(x[i]) == "") {
y[i] <- fizzbuzz(x[i])
} else {
y[i] <- x[i]
}
}
return(y)
}
